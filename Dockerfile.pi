# syntax=docker/dockerfile:1.7

FROM node:22.22.0-alpine

ENV NODE_ENV=production \
    PI_SERVICE_HOST=0.0.0.0 \
    PI_SERVICE_PORT=8010

WORKDIR /app

COPY apps/pi-service/package.json apps/pi-service/package-lock.json ./
RUN --mount=type=cache,id=enerledger-pi-npm,target=/root/.npm,sharing=locked \
    npm ci --omit=dev --ignore-scripts

COPY apps/pi-service/src ./src
COPY apps/pi-service/resources ./resources

RUN addgroup -S pi && adduser -S -G pi -u 10001 pi
USER pi

EXPOSE 8010

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=5 \
    CMD node -e "fetch('http://127.0.0.1:8010/internal/report-agent/readiness',{headers:{Authorization:'Bearer '+process.env.PI_SERVICE_TOKEN}}).then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"

CMD ["node", "src/server.js"]

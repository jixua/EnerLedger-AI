{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enerledger.local/schemas/report-template-definition.json",
  "title": "Report Template Definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["template_id", "report_type", "version", "name", "status", "description", "applicable_documents", "inapplicable_documents", "fields", "sections", "calculations", "disclaimers", "render_profile"],
  "properties": {
    "template_id": {"type": "string", "pattern": "^r[1-7]-[a-z0-9-]+$"},
    "report_type": {"enum": ["R1", "R2", "R3", "R4", "R5", "R6", "R7"]},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "name": {"type": "string", "minLength": 1},
    "status": {"enum": ["DRAFT", "ACTIVE", "RETIRED"]},
    "description": {"type": "string", "minLength": 1},
    "applicable_documents": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "inapplicable_documents": {"type": "array", "items": {"type": "string"}},
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "type", "required", "blocking", "unit", "source_types", "validation", "formula_id"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "label": {"type": "string", "minLength": 1},
          "type": {"enum": ["string", "text", "integer", "number", "date", "date_range", "enum", "array", "url"]},
          "required": {"type": "boolean"},
          "blocking": {"type": "boolean"},
          "unit": {"type": ["string", "null"]},
          "source_types": {"type": "array", "items": {"enum": ["DOCUMENT", "KNOWLEDGE_BASE", "USER_INPUT", "CALCULATION"]}, "minItems": 1, "uniqueItems": true},
          "validation": {"type": "object"},
          "formula_id": {"type": ["string", "null"]}
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "required", "field_ids", "allowed_blocks"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "title": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "field_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "allowed_blocks": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}
        }
      }
    },
    "calculations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["formula_id", "version", "output_field_id", "input_field_ids", "description", "operator"],
        "properties": {
          "formula_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
          "version": {"type": "string"},
          "output_field_id": {"type": "string"},
          "input_field_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "description": {"type": "string"},
          "operator": {"enum": ["SUM", "DIVIDE", "SCALED_DIVIDE", "PERCENT", "WEIGHTED_SUM"]},
          "scale": {"type": "number"},
          "parameter_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "collection_value_key": {"type": "string"}
        }
      }
    },
    "disclaimers": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "render_profile": {"type": "string", "minLength": 1}
  }
}

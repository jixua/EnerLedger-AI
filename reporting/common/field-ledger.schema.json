{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enerledger.local/schemas/report-field-ledger.json",
  "title": "Report Field Ledger Item",
  "type": "object",
  "additionalProperties": false,
  "required": ["field_id", "status", "evidence_ids", "confidence", "notes"],
  "properties": {
    "field_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "status": {
      "enum": [
        "FOUND",
        "CALCULATED",
        "USER_SUPPLIED",
        "MISSING",
        "CONFLICT",
        "NOT_APPLICABLE",
        "UNVERIFIED"
      ]
    },
    "value": {},
    "unit": {"type": ["string", "null"]},
    "evidence_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^E-[A-Za-z0-9_-]+$"},
      "uniqueItems": true
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "notes": {"type": "array", "items": {"type": "string"}},
    "calculation": {
      "type": ["object", "null"],
      "properties": {
        "formula_id": {"type": "string"},
        "formula_version": {"type": "string"},
        "input_field_ids": {"type": "array", "items": {"type": "string"}}
      },
      "required": ["formula_id", "formula_version", "input_field_ids"],
      "additionalProperties": false
    }
  }
}

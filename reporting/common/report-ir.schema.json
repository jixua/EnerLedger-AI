{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enerledger.local/schemas/report-ir.json",
  "title": "EnerLedger Report IR",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "meta", "evidence", "field_ledger", "sections", "calculations", "warnings", "limitations", "render_profile"],
  "properties": {
    "schema_version": {"const": 1},
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "report_type", "template_id", "template_version"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "report_type": {"enum": ["R1", "R2", "R3", "R4", "R5", "R6", "R7"]},
        "template_id": {"type": "string", "minLength": 1},
        "template_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "document_id": {"type": ["integer", "null"], "minimum": 1},
        "document_version": {"type": ["integer", "null"], "minimum": 1},
        "source_filename": {"type": ["string", "null"]},
        "language": {"type": "string", "default": "zh-CN"}
      }
    },
    "evidence": {
      "type": "array",
      "items": {"$ref": "evidence.schema.json"}
    },
    "field_ledger": {
      "type": "array",
      "items": {"$ref": "field-ledger.schema.json"}
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section_id", "title", "blocks"],
        "properties": {
          "section_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "title": {"type": "string", "minLength": 1},
          "blocks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "evidence_ids"],
              "properties": {
                "type": {
                  "enum": ["heading", "paragraph", "list", "table", "metric_cards", "bar_chart", "donut_chart", "timeline", "risk_matrix", "callout", "source_note", "signature_block", "page_break"]
                },
                "text": {"type": "string", "description": "段落正文；表格与图表块这里是标题（caption）"},
                "data": {},
                "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
              },
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {"required": ["type"], "properties": {"type": {"const": "table"}}},
                  "then": {"properties": {"data": {"$ref": "#/$defs/tableData"}}}
                },
                {
                  "if": {"required": ["type"], "properties": {"type": {"const": "metric_cards"}}},
                  "then": {"properties": {"data": {"$ref": "#/$defs/metricData"}}}
                },
                {
                  "if": {"required": ["type"], "properties": {"type": {"enum": ["bar_chart", "donut_chart"]}}},
                  "then": {"properties": {"data": {"$ref": "#/$defs/seriesData"}}}
                }
              ]
            }
          }
        }
      }
    },
    "calculations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["formula_id", "formula_version", "operator", "input_field_ids", "inputs", "parameters", "parameter_evidence_ids", "output_field_id", "value", "unit"],
        "properties": {
          "formula_id": {"type": "string"},
          "formula_version": {"type": "string"},
          "operator": {"type": "string"},
          "input_field_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "inputs": {"type": "object"},
          "parameters": {"type": "object"},
          "parameter_evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "output_field_id": {"type": "string"},
          "value": {"type": "number"},
          "unit": {"type": ["string", "null"]}
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string"},
      "description": "读正文之前需要知道的口径与数据问题：数值口径差异、未纳入统计的项、来源不确定的参数。每条一句话；正文中已经说明过的内容不要在这里重复。"
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string"},
      "description": "报告的适用边界与免责：本报告的性质（草稿或辅助分析）、不能替代什么、以及遗留的不确定性。与 warnings 的区别是这里讲报告本身可信到什么程度，不涉及具体数值。"
    },
    "render_profile": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "tableData": {
      "type": "object",
      "required": ["columns", "rows"],
      "properties": {
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"},
          "description": "列名，按显示顺序排列。表格必须有列名：没有列名的表格在 Word 里会退化成一段带竖线的文字。"
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "description": "每行一个数组，元素顺序与 columns 一致；空值写 null。",
          "items": {
            "anyOf": [
              {"type": "array", "items": {"type": ["string", "number", "null"]}},
              {"type": "object"}
            ]
          }
        },
        "unit": {"type": "string"}
      }
    },
    "metricData": {
      "type": "object",
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "description": "关键指标卡：每项 {label, value}，label 是说法（产品名称、功能单位），value 是取值或一句话。",
          "items": {
            "type": "object",
            "required": ["label", "value"],
            "properties": {
              "label": {"type": "string"},
              "value": {"type": ["string", "number", "null"]}
            }
          }
        }
      }
    },
    "seriesData": {
      "type": "object",
      "required": ["series"],
      "properties": {
        "series": {
          "type": "array",
          "minItems": 1,
          "description": "图表分项：每项 {label, value}；value 为数值，负值会被识别为减排／抵扣并改画发散条。",
          "items": {
            "type": "object",
            "required": ["label", "value"],
            "properties": {
              "label": {"type": "string"},
              "value": {"type": ["number", "string", "null"]}
            }
          }
        },
        "unit": {"type": "string", "description": "数值单位，用于表头与图注。"}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enerledger.local/schemas/template-registry.schema.json",
  "title": "Report template registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_version", "templates"],
  "properties": {
    "$schema": {"type": "string"},
    "registry_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "templates": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["report_type", "template_id", "version", "status", "definition_path"],
        "properties": {
          "report_type": {"enum": ["R1", "R2", "R3", "R4", "R5", "R6", "R7"]},
          "template_id": {"type": "string", "pattern": "^r[1-7]-[a-z0-9-]+$"},
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "status": {"enum": ["DRAFT", "ACTIVE", "RETIRED"]},
          "definition_path": {"type": "string", "pattern": "^[^/]+/definition\\.json$"}
        }
      }
    }
  }
}

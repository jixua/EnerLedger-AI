# 复制为 .env 后再启动。下列口令只用于本地开发，生产必须全部替换。
APP_NAME="能碳会计 AI 智能体"
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
API_PORT=8000
CORS_ALLOW_ORIGINS=http://127.0.0.1:4173,http://localhost:4173,http://127.0.0.1:4175,http://localhost:4175
LOG_LEVEL=INFO
LOG_FILE_ENABLED=false
TZ=Asia/Shanghai

# MySQL 8：业务 schema 只有 dataset/document/document_chunk/llm_config 四张表。
MYSQL_ROOT_PASSWORD=mysql-root-local-change-me
MYSQL_PORT=3306
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=tolink
DB_PASSWORD=tolink-local-change-me
DB_NAME=tolink_rag_db
# Docker Compose 中的主机名必须是 mysql；本机直跑时改成 127.0.0.1。
DATABASE_URL=mysql+pymysql://tolink:tolink-local-change-me@mysql:3306/tolink_rag_db?charset=utf8mb4

# llm_config.api_key 使用 AES-256-GCM 加密。必须是 64 个十六进制字符。
# 生产可用 `openssl rand -hex 32` 生成；密钥丢失后历史 API Key 无法解密。
API_KEY_ENCRYPTION_SECRET=

# MinIO：Compose 使用同一组凭证启动服务，并创建原文件桶和私有解析产物桶。
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minio-local-change-me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
STORAGE_TYPE=minio
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9000
MINIO_RAW_BUCKET=tolink-rag-raw
MINIO_PRIVATE_BUCKET=tolink-rag-docs
MINIO_USE_SSL=false
DOCUMENT_UPLOAD_MAX_BYTES=104857600
DOCUMENT_QUEUE_POLL_INTERVAL_SECONDS=2
DOCUMENT_QUEUE_LEASE_SECONDS=300
DOCUMENT_QUEUE_HEARTBEAT_SECONDS=30
DOCUMENT_QUEUE_MAX_ATTEMPTS=3
DOCUMENT_QUEUE_RETRY_DELAYS_SECONDS=30,120,600
DOCUMENT_QUEUE_WORKER_CONCURRENCY=1

# PDF 固定走当前源码内的 OpenDataLoader。上传请求只入队，由 parse-worker 异步处理。
PDF_PARSER_BACKEND=opendataloader
PDF_PARSER_FALLBACKS=
PDF_IMAGE_UPLOAD_ASYNC=false
PARSE_TEMP_DIR=/tmp/energy-carbon-rag
NLTK_DATA=./nltk_data

# Qdrant 1.17.1：Dense 与 Sparse 共用一个 collection 的 named vectors。
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://qdrant:6333
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_HTTPS=false
QDRANT_API_KEY=
QDRANT_TIMEOUT_SECONDS=20
CHUNK_INDEX_COLLECTION_NAME=tolink_rag_chunks
DENSE_VECTOR_QDRANT_VECTOR_NAME=dense
SPARSE_VECTOR_QDRANT_VECTOR_NAME=sparse_text
# 必须与 dataset 绑定的 EMBEDDING 模型实际输出维度一致。
DENSE_VECTOR_DIMENSION=1024
SPARSE_VECTOR_ENABLED=true

# Manticore 27.1.5：业务代码连接 9306 SQL 端口。
MANTICORE_SQL_PORT=9306
MANTICORE_HTTP_PORT=9308
MANTICORE_HOST=manticore
MANTICORE_PORT=9306
MANTICORE_USER=
MANTICORE_PASSWORD=
MANTICORE_BM25_TABLE_PREFIX=bm25_ds_v2

# 三路召回：BM25/Sparse 先 log1p，再分别 min-max，最后固定加权融合。
RECALL_ENABLED_SOURCES=bm25,sparse,dense
RECALL_STREAM_TIMEOUT_MS=60000
RECALL_RESULT_LIMIT=64
RECALL_BM25_TOP_K=100
RECALL_SPARSE_TOP_K=50
RECALL_DENSE_TOP_K=100
RECALL_FUSION_BM25_WEIGHT=0.15
RECALL_FUSION_SPARSE_WEIGHT=0.15
RECALL_FUSION_DENSE_WEIGHT=0.70
RECALL_STRICT_DEFAULT=false
RECALL_LTR_MODE=off

# POST /api/v1/rag/stream 的上下文与生成超时。
RECALL_GENERATION_CONTEXT_TOKEN_BUDGET=4000
RECALL_GENERATION_TIMEOUT_MS=300000

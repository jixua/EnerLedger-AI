# Compose 发布定位。RELEASE_SHA 由发布脚本注入，不需要手工维护。
GHCR_NAMESPACE=ghcr.io/jixua
RELEASE_SHA=0000000000000000000000000000000000000000
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=18080
API_BIND_ADDRESS=127.0.0.1
API_PORT=18000
MINIO_BIND_ADDRESS=127.0.0.1
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
COMPOSE_PROFILES=

# 应用基本配置。
APP_NAME=能碳会计 AI 智能体
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ALLOW_ORIGINS=https://example.com
LOG_LEVEL=INFO
LOG_FILE_ENABLED=false
TZ=Asia/Shanghai

# MySQL。生产文件不得保留这些占位值。
MYSQL_ROOT_PASSWORD=replace-with-random-hex
DB_HOST=mysql
DB_PORT=3306
DB_USER=tolink
DB_PASSWORD=replace-with-random-hex
DB_NAME=tolink_rag_db
DATABASE_URL=mysql+pymysql://tolink:replace-with-random-hex@mysql:3306/tolink_rag_db?charset=utf8mb4

# 身份与加密。ADMIN_PASSWORD_HASH 必须是 app.domain.auth 生成的 scrypt 值。
API_KEY_ENCRYPTION_SECRET=replace-with-64-hex-characters
ADMIN_USERNAME=root
ADMIN_PASSWORD_HASH=scrypt:16384:8:1:replace-salt:replace-hash
JWT_SECRET=replace-with-random-secret
JWT_ISSUER=energy-carbon-rag
JWT_AUDIENCE=energy-carbon-web
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# MinIO 仅绑定宿主机回环地址。PUBLIC_ENDPOINT 必须是真实受控的 HTTPS 访问地址。
MINIO_ACCESS_KEY=replace-with-random-access-key
MINIO_SECRET_KEY=replace-with-random-secret-key
STORAGE_TYPE=minio
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=https://files.example.com
MINIO_RAW_BUCKET=tolink-rag-raw
MINIO_PRIVATE_BUCKET=tolink-rag-docs
MINIO_USE_SSL=false

# RabbitMQ。
RABBITMQ_USER=energy-carbon
RABBITMQ_PASSWORD=replace-with-random-hex
RABBITMQ_VHOST=energy-carbon
RABBITMQ_URL=amqp://energy-carbon:replace-with-random-hex@rabbitmq:5672/energy-carbon
RABBITMQ_PREFETCH_COUNT=1

# Pi Agent。两枚 Token 必须不同且至少 32 字符。
AGENT_ENABLED=false
PI_SERVICE_BASE_URL=http://pi-agent:8010
PI_SERVICE_URL=http://pi-agent:8010
PI_SERVICE_TOKEN=replace-with-random-token-at-least-32-characters
ENERLEDGER_INTERNAL_AGENT_TOKEN=replace-with-another-random-token-32-characters
AGENT_RUN_TIMEOUT_SECONDS=120
AGENT_TOOL_TIMEOUT_SECONDS=30

# 文档解析、检索与外部服务。
DOCUMENT_QUEUE_WORKER_CONCURRENCY=1
PDF_PARSER_BACKEND=opendataloader
PDF_PARSER_FALLBACKS=mineru
PDF_IMAGE_UPLOAD_ASYNC=false
MINERU_API_URL=https://mineru.net/api/v4/extract/task
MINERU_API_TOKEN=
MINERU_TIMEOUT=900
MINERU_MODEL_VERSION=vlm
QDRANT_URL=http://qdrant:6333
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
MANTICORE_HOST=manticore
MANTICORE_PORT=9306
CHUNKING_STAGE_TWO_ALGORITHM=semantic_depth_window
RECALL_LTR_MODE=off

# 报告 Worker 默认不启动。启用时设置 COMPOSE_PROFILES=reports 并填写全部报告 Token。
REPORT_PROCESSOR_MODE=disabled
REPORT_AGENT_INTERNAL_TOKEN=
REPORT_AGENT_RUN_TOKEN_SECRET=
REPORT_AGENT_RUN_TOKEN_TTL_SECONDS=900
REPORT_AGENT_RUN_TIMEOUT_SECONDS=600
REPORT_AGENT_MAX_TOOL_CALLS=80

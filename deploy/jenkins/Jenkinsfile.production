node {
  timestamps {
    env.DEPLOY_ROOT = '/opt/enerledger-ai'
    env.IMAGE_NAMESPACE = 'ghcr.io/jixua'
    env.NLTK_BUNDLE = '/opt/tolink/jenkins-cache/enerledger-nltk/nltk-data-v1.tar.gz'
    env.NLTK_BUNDLE_SHA256 = 'b2a01515e237cf8746fd659fb66e526b3fba9d6c3d046176de8fdc5035a5040f'
    stage('Refresh source mirror') {
      // 构建机到 GitHub 只有约 18 KB/s，还会整段停滞：depth=100 的浅克隆约 14 MiB，
      // 直接克隆反复失败（构建 #17–#22：超时被杀、连接超时、传到一半停住，各种死法）。
      // 所以改成从本地镜像克隆，克隆前先把新增提交拉进镜像——每次要传的量从 14 MiB
      // 降到几个提交。刷新失败即终止构建，绝不拿旧代码去部署。
      // 镜像位置：/var/jenkins_home/mirror/EnerLedger-AI.git（在 Jenkins 持久卷里，
      // 不受工作区清理影响）。
      sh '''
        set -eu
        MIRROR=/var/jenkins_home/mirror/EnerLedger-AI.git
        test -d "$MIRROR" || { echo "本地镜像不存在：$MIRROR，需要先同步一次"; exit 1; }
        timeout 600 git -C "$MIRROR" fetch --depth=100 --no-tags origin +refs/heads/master:refs/heads/master
      '''
    }
    stage('Checkout master') {
      deleteDir()
      // 这里不用 Jenkins 的 checkout 步骤：它默认拒绝 file:// 本地检出
      // （hudson.plugins.git.GitSCM.ALLOW_LOCAL_CHECKOUT 的默认安全策略），
      // 直接用 git 克隆。后面的阶段本来就用 git rev-parse / git diff 取版本，
      // 不依赖 checkout 提供的变更记录。
      sh 'git clone --depth=100 --no-tags --single-branch --branch master file:///var/jenkins_home/mirror/EnerLedger-AI.git .'
      env.SOURCE_SHA = sh(returnStdout: true, script: 'git rev-parse HEAD').trim()
      env.SOURCE_SHORT = sh(returnStdout: true, script: 'git rev-parse --short=7 HEAD').trim()
    }
    stage('Select changed application images') {
      sh '''
        set -eu
        previous="$(cat "$DEPLOY_ROOT/.deployment/current_sha" 2>/dev/null || true)"
        if [ -z "$previous" ] || ! git cat-file -e "$previous^{commit}" 2>/dev/null || ! git merge-base --is-ancestor "$previous" "$SOURCE_SHA"; then changed='*'; else changed="$(git diff --name-only "$previous" "$SOURCE_SHA")"; fi
        needs() { printf '%s\\n' "$changed" | grep -Eq "$1"; }
        : > .production-build-components
        if [ "$changed" = '*' ] || needs '^(Dockerfile|pyproject.toml|uv.lock|README.md|alembic.ini|app/|reporting/|migrations/|docker/)'; then echo api >> .production-build-components; fi
        if [ "$changed" = '*' ] || needs '^(third_party/pi/|apps/pi-service/|deploy/jenkins/Dockerfile.pi$)'; then echo pi >> .production-build-components; fi
        if [ "$changed" = '*' ] || needs '^(frontend/|deploy/production/Dockerfile.frontend$|deploy/production/nginx.conf$)'; then echo web >> .production-build-components; fi
        for component in api pi web; do
          current="$(cat "$DEPLOY_ROOT/.deployment/${component}_sha" 2>/dev/null || cat "$DEPLOY_ROOT/.deployment/current_sha" 2>/dev/null || true)"
          case "$component" in api) var=API_RELEASE_SHA;; pi) var=PI_RELEASE_SHA;; web) var=WEB_RELEASE_SHA;; esac
          if grep -qx "$component" .production-build-components || [ -z "$current" ]; then eval "export $var='$SOURCE_SHA'"; else eval "export $var='$current'"; fi
        done
        printf 'API_RELEASE_SHA=%s\\nPI_RELEASE_SHA=%s\\nWEB_RELEASE_SHA=%s\\n' "$API_RELEASE_SHA" "$PI_RELEASE_SHA" "$WEB_RELEASE_SHA" > .production-images.env
      '''
    }
    stage('Build changed application images locally') {
      sh '''
        set -eu; . ./.production-images.env
        if grep -qx api .production-build-components; then test -r "$NLTK_BUNDLE"; printf '%s  %s\\n' "$NLTK_BUNDLE_SHA256" "$NLTK_BUNDLE" | sha256sum -c -; rm -rf .build-cache/nltk_data; mkdir -p .build-cache/nltk_data; tar -xzf "$NLTK_BUNDLE" --strip-components=1 -C .build-cache/nltk_data; docker build --build-arg NLTK_ASSETS_MODE=cache -t "$IMAGE_NAMESPACE/enerledger-api:$API_RELEASE_SHA" .; fi
        if grep -qx pi .production-build-components; then docker build -f deploy/jenkins/Dockerfile.pi -t "$IMAGE_NAMESPACE/enerledger-pi:$PI_RELEASE_SHA" .; fi
        if grep -qx web .production-build-components; then docker build -f deploy/production/Dockerfile.frontend -t "$IMAGE_NAMESPACE/enerledger-web:$WEB_RELEASE_SHA" .; fi
      '''
    }
    stage('Deploy and verify locally') {
      sh '''
        set -eu; . ./.production-images.env
        install -d -m 750 "$DEPLOY_ROOT/bin"
        install -m 640 deploy/production/docker-compose.yml "$DEPLOY_ROOT/docker-compose.yml"
        install -m 750 \
          deploy/production/scripts/deploy.sh \
          deploy/production/scripts/rollback.sh \
          deploy/production/scripts/validate-env.sh \
          deploy/production/scripts/verify.sh \
          "$DEPLOY_ROOT/bin/"
        SKIP_PULL=true GHCR_NAMESPACE="$IMAGE_NAMESPACE" RELEASE_SHA="$SOURCE_SHA" API_RELEASE_SHA="$API_RELEASE_SHA" PI_RELEASE_SHA="$PI_RELEASE_SHA" WEB_RELEASE_SHA="$WEB_RELEASE_SHA" "$DEPLOY_ROOT/bin/deploy.sh" "$DEPLOY_ROOT"
      '''
    }
    currentBuild.description = "master ${env.SOURCE_SHORT} / Production / local build"
  }
}

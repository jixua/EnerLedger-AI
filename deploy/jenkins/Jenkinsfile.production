node {
    timestamps {
        env.DEPLOY_ROOT = '/opt/enerledger-ai'
        env.IMAGE_NAMESPACE = 'ghcr.io/jixua'
        env.PRODUCTION_HOST = '1.15.66.7'
        env.PRODUCTION_PORT = '18631'
        env.PRODUCTION_USER = 'deploy'
        env.PRODUCTION_SSH_KEY = '/opt/tolink/jenkins-secrets/enerledger-production/id_ed25519'
        env.PRODUCTION_KNOWN_HOSTS = '/opt/tolink/jenkins-secrets/enerledger-production/known_hosts'

        stage('Checkout master') {
            deleteDir()
            checkout scm
            env.SOURCE_SHA = sh(returnStdout: true, script: 'git rev-parse HEAD').trim()
            env.SOURCE_SHORT = sh(returnStdout: true, script: 'git rev-parse --short=7 HEAD').trim()
            sh '''
                set -eu
                test "$(git rev-parse HEAD)" = "$SOURCE_SHA"
                test "$(git rev-parse refs/remotes/origin/master)" = "$SOURCE_SHA"
                test -f deploy/production/docker-compose.yml
                test -f deploy/production/scripts/deploy.sh
            '''
        }

        stage('Build immutable application images') {
            sh '''
                set -eu
                docker build \
                  --label "org.opencontainers.image.revision=$SOURCE_SHA" \
                  --label "org.opencontainers.image.source=https://github.com/jixua/EnerLedger-AI" \
                  -f Dockerfile \
                  -t "$IMAGE_NAMESPACE/enerledger-api:$SOURCE_SHA" .
                docker build \
                  --label "org.opencontainers.image.revision=$SOURCE_SHA" \
                  --label "org.opencontainers.image.source=https://github.com/jixua/EnerLedger-AI" \
                  -f deploy/jenkins/Dockerfile.pi \
                  -t "$IMAGE_NAMESPACE/enerledger-pi:$SOURCE_SHA" .
                docker build \
                  --label "org.opencontainers.image.revision=$SOURCE_SHA" \
                  --label "org.opencontainers.image.source=https://github.com/jixua/EnerLedger-AI" \
                  -f deploy/production/Dockerfile.frontend \
                  -t "$IMAGE_NAMESPACE/enerledger-web:$SOURCE_SHA" .
            '''
        }

        stage('Prepare pinned middleware images') {
            sh '''
                set -eu
                pull_and_tag() {
                    source="$1"
                    target="$2"
                    docker pull --platform linux/amd64 "$source"
                    docker tag "$source" "$target"
                }

                pull_and_tag \
                  'docker.io/library/mysql@sha256:63823b8e2cbe4ae0c558155e02d00beba56130fbc3d147efccbdb328ae2dbb9e' \
                  "$IMAGE_NAMESPACE/enerledger-mysql:8.0.42"
                pull_and_tag \
                  'quay.io/minio/minio@sha256:14cea493d9a34af32f524e538b8346cf79f3321eff8e708c1e2960462bd8936e' \
                  "$IMAGE_NAMESPACE/enerledger-minio:RELEASE.2025-09-07T16-13-09Z"
                pull_and_tag \
                  'quay.io/minio/mc@sha256:a7fe349ef4bd8521fb8497f55c6042871b2ae640607cf99d9bede5e9bdf11727' \
                  "$IMAGE_NAMESPACE/enerledger-minio-mc:RELEASE.2025-08-13T08-35-41Z"
                pull_and_tag \
                  'docker.io/qdrant/qdrant@sha256:94728574965d17c6485dd361aa3c0818b325b9016dac5ea6afec7b4b2700865f' \
                  "$IMAGE_NAMESPACE/enerledger-qdrant:v1.17.1"
                pull_and_tag \
                  'docker.io/manticoresearch/manticore@sha256:511cfcbe22669e101fdc3818afc6ef709cf659e300f9a83d2cf4291421081228' \
                  "$IMAGE_NAMESPACE/enerledger-manticore:27.1.5"
                pull_and_tag \
                  'docker.io/library/rabbitmq@sha256:eb6736723c5d0831ab12d29e7a2b8ee1082f744370c2a784b50b84b3b4d6d030' \
                  "$IMAGE_NAMESPACE/enerledger-rabbitmq:4.1.8-management-alpine"
            '''
        }

        stage('Validate deployment bundle') {
            sh '''
                set -eu
                for script in deploy/production/scripts/*.sh; do
                    bash -n "$script"
                done
                test -r "$PRODUCTION_SSH_KEY"
                test -r "$PRODUCTION_KNOWN_HOSTS"
                test "$(stat -c '%a' "$PRODUCTION_SSH_KEY")" = 600
                test "$(stat -c '%a' "$PRODUCTION_KNOWN_HOSTS")" = 600
            '''
        }

        stage('Sync deployment contract') {
            sh '''
                set -eu
                target="$PRODUCTION_USER@$PRODUCTION_HOST"
                ssh -i "$PRODUCTION_SSH_KEY" \
                  -o UserKnownHostsFile="$PRODUCTION_KNOWN_HOSTS" \
                  -o StrictHostKeyChecking=yes \
                  -p "$PRODUCTION_PORT" "$target" \
                  "mkdir -p '$DEPLOY_ROOT/bin'"
                scp -i "$PRODUCTION_SSH_KEY" \
                  -o UserKnownHostsFile="$PRODUCTION_KNOWN_HOSTS" \
                  -o StrictHostKeyChecking=yes \
                  -P "$PRODUCTION_PORT" \
                  deploy/production/docker-compose.yml \
                  "$target:$DEPLOY_ROOT/docker-compose.yml"
                scp -i "$PRODUCTION_SSH_KEY" \
                  -o UserKnownHostsFile="$PRODUCTION_KNOWN_HOSTS" \
                  -o StrictHostKeyChecking=yes \
                  -P "$PRODUCTION_PORT" \
                  deploy/production/scripts/deploy.sh \
                  deploy/production/scripts/rollback.sh \
                  deploy/production/scripts/validate-env.sh \
                  deploy/production/scripts/verify.sh \
                  "$target:$DEPLOY_ROOT/bin/"
                ssh -i "$PRODUCTION_SSH_KEY" \
                  -o UserKnownHostsFile="$PRODUCTION_KNOWN_HOSTS" \
                  -o StrictHostKeyChecking=yes \
                  -p "$PRODUCTION_PORT" "$target" \
                  "chmod 750 '$DEPLOY_ROOT'/bin/*.sh"
            '''
        }

        stage('Stream images to production') {
            sh '''
                set -eu
                target="$PRODUCTION_USER@$PRODUCTION_HOST"
                image_list="/tmp/enerledger-production-images-$BUILD_NUMBER.txt"
                trap 'rm -f "$image_list"' EXIT
                cat >"$image_list" <<EOF
$IMAGE_NAMESPACE/enerledger-api:$SOURCE_SHA
$IMAGE_NAMESPACE/enerledger-pi:$SOURCE_SHA
$IMAGE_NAMESPACE/enerledger-web:$SOURCE_SHA
$IMAGE_NAMESPACE/enerledger-mysql:8.0.42
$IMAGE_NAMESPACE/enerledger-minio:RELEASE.2025-09-07T16-13-09Z
$IMAGE_NAMESPACE/enerledger-minio-mc:RELEASE.2025-08-13T08-35-41Z
$IMAGE_NAMESPACE/enerledger-qdrant:v1.17.1
$IMAGE_NAMESPACE/enerledger-manticore:27.1.5
$IMAGE_NAMESPACE/enerledger-rabbitmq:4.1.8-management-alpine
EOF
                while IFS= read -r image; do
                    docker image inspect "$image" >/dev/null
                done <"$image_list"
                xargs docker save <"$image_list" | gzip -1 | \
                  ssh -i "$PRODUCTION_SSH_KEY" \
                    -o UserKnownHostsFile="$PRODUCTION_KNOWN_HOSTS" \
                    -o StrictHostKeyChecking=yes \
                    -o ServerAliveInterval=30 \
                    -o ServerAliveCountMax=10 \
                    -p "$PRODUCTION_PORT" "$target" \
                    'gzip -dc | docker load'
            '''
        }

        stage('Deploy and verify production') {
            sh '''
                set -eu
                target="$PRODUCTION_USER@$PRODUCTION_HOST"
                ssh -i "$PRODUCTION_SSH_KEY" \
                  -o UserKnownHostsFile="$PRODUCTION_KNOWN_HOSTS" \
                  -o StrictHostKeyChecking=yes \
                  -o ServerAliveInterval=30 \
                  -o ServerAliveCountMax=10 \
                  -p "$PRODUCTION_PORT" "$target" \
                  "SKIP_PULL=true GHCR_NAMESPACE='$IMAGE_NAMESPACE' RELEASE_SHA='$SOURCE_SHA' '$DEPLOY_ROOT/bin/deploy.sh' '$DEPLOY_ROOT'"
            '''
        }

        currentBuild.description = "master ${env.SOURCE_SHORT} / Production / b${env.BUILD_NUMBER}"
    }
}

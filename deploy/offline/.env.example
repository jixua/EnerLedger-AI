# 复制为 .env；所有 CHANGE_ME 项必须替换。不要把真实 .env 提交到 Git。
COMPOSE_PROJECT_NAME=enerledger-offline
APP_ENV=production
FRONTEND_PORT=8080
API_PORT=8000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9000

# 镜像名称必须与 images/images.lock 中的归档名称一致。
API_IMAGE=enerledger/api:offline
FRONTEND_IMAGE=enerledger/frontend:offline
PI_AGENT_IMAGE=enerledger/pi-agent:offline
MYSQL_IMAGE=mysql:8.0.42
MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
QDRANT_IMAGE=qdrant/qdrant:v1.17.1
MANTICORE_IMAGE=manticoresearch/manticore:27.1.5
RABBITMQ_IMAGE=rabbitmq:4.1.8-management-alpine

MYSQL_ROOT_PASSWORD=CHANGE_ME
DB_NAME=tolink_rag_db
DB_USER=tolink
DB_PASSWORD=CHANGE_ME
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_RAW_BUCKET=tolink-rag-raw
MINIO_PRIVATE_BUCKET=tolink-rag-docs
RABBITMQ_USER=energy-carbon
RABBITMQ_PASSWORD=CHANGE_ME
RABBITMQ_VHOST=energy-carbon

# 迁移 llm_config 数据时必须沿用源环境 API_KEY_ENCRYPTION_SECRET，否则模型密钥无法解密。
API_KEY_ENCRYPTION_SECRET=CHANGE_ME_64_HEX
ADMIN_USERNAME=root
ADMIN_PASSWORD_HASH=CHANGE_ME_SCRYPT_HASH
JWT_SECRET=CHANGE_ME
JWT_ISSUER=energy-carbon-rag
JWT_AUDIENCE=energy-carbon-web
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

AGENT_ENABLED=true
PI_SERVICE_TOKEN=CHANGE_ME
ENERLEDGER_INTERNAL_AGENT_TOKEN=CHANGE_ME
REPORT_AGENT_INTERNAL_TOKEN=CHANGE_ME
REPORT_AGENT_RUN_TOKEN_SECRET=CHANGE_ME
CRAWLER_UPLOAD_API_KEY=CHANGE_ME

DOCUMENT_QUEUE_WORKER_CONCURRENCY=1
RABBITMQ_PREFETCH_COUNT=1
PDF_FALLBACK_MAX_CONCURRENCY=1
WORD_MAX_CONCURRENCY=1
PDF_PARSER_BACKEND=opendataloader
PDF_PARSER_FALLBACKS=mineru
MINERU_API_TOKEN=

QDRANT_API_KEY=
CHUNK_INDEX_COLLECTION_NAME=tolink_rag_chunks_v2
DENSE_VECTOR_QDRANT_VECTOR_NAME=dense
SPARSE_VECTOR_QDRANT_VECTOR_NAME=sparse_text
DENSE_VECTOR_DIMENSION=2048
SPARSE_VECTOR_ENABLED=true
MANTICORE_BM25_TABLE_PREFIX=bm25_ds_v2

REPORT_PROCESSOR_MODE=disabled
REPORT_QUEUE_WORKER_CONCURRENCY=1
